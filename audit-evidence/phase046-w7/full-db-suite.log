	      -- attempt at the failure moment when nothing ran before it.
	      started_at = COALESCE(started_at, now()),
	      finished_at = now(),
	      duration_ms = $1,
	      error_code = $2,
	      error_detail = $3::jsonb,
	      artifacts = NULL
	    WHERE id = $4
	  

