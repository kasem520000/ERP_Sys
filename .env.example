# PHASE-001 development environment template.
# Copy to .env for local use — never commit real secrets (gitleaks runs in CI).

# App connection (non-owner role erp_app is created by migration 0001 in PHASE-002)
DATABASE_URL=postgres://erp_app:erp_app@localhost:5432/erp

# Object storage — minio local stand-in (files module, PHASE-002+)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=erp-files

# Identity secret envelope (PHASE-003: TOTP-secret encryption + reset-token
# HMAC derivation). 32 bytes, base64. Dev default below is a LOCAL-ONLY
# placeholder: production sets it out-of-band (SECRETS_MANAGEMENT); unset in
# development/test, the API derives the documented local dev key.
# Generate: openssl rand -base64 32
# IDENTITY_SECRET_KEY=
# IDENTITY_SECRET_KEY_ID=v1
# PHASE-024 T6 — S-03 dual-accept rotation window (SECRETS_MANAGEMENT §3):
# during a key rotation, set the PREVIOUS key + its id alongside the new
# IDENTITY_SECRET_KEY — sealed-in-flight secrets stay readable through the
# window; remove both once the window closes (old-key envelopes then fail
# closed). Unset outside a rotation.
# Runbook: docs/operations/SECRETS_ROTATION_RUNBOOK.md §2
# IDENTITY_SECRET_KEY_PREVIOUS=
# IDENTITY_SECRET_KEY_ID_PREVIOUS=v1

# PHASE-014 billing webhook HMAC secret (provider adapter signature scheme,
# header billing-signature / webhook-signature `t=…,v1=…`). Unset in
# dev/test → documented LOCAL-ONLY default; production sets it out-of-band.
# BILLING_WEBHOOK_SECRET=
# PHASE-024 T6 — S-11 dual-secret window (SECRETS_MANAGEMENT §3): during a
# provider-coordinated webhook-secret rotation, set the PREVIOUS secret —
# deliveries signed with either secret pass while it is set; remove it once
# the provider confirms full cutover. Unset outside a rotation.
# Runbook: docs/operations/SECRETS_ROTATION_RUNBOOK.md §4
# WEBHOOK_SIGNING_SECRET_PREVIOUS=

# PHASE-023 e-invoicing sealed-artifact key (submission payloads + authority
# responses at rest): AES-256-GCM envelope, 32 bytes base64. Same envelope
# as IDENTITY_SECRET_KEY; unset → derived local dev key; production fails
# closed. Falls back to IDENTITY_SECRET_KEY when set (one platform key
# envelope is acceptable — the artifact class is tenant-scoped the same way).
# Generate: openssl rand -base64 32
# EINVOICING_SECRET_KEY=
# EINVOICING_SECRET_KEY_ID=v1

# Outbound mail — mailpit local sink (notifications module, PHASE-003).
# Unset SMTP_HOST disables sending with a warning (documented dev shape).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@erp.local
# SMTP_USER=
# SMTP_PASS=

# Push notifications — FCM v1 (notifications module, PHASE-022; integrations
# §3.5). A Google service-account JSON string (project_id + client_email +
# private_key — the firebase.messaging scope is derived from it).
# Unset FCM_CREDENTIALS disables the channel with an init log line (the
# DisabledSmtpTransport pattern); production sets it from the secrets store.
# FCM_CREDENTIALS=

# Public origin of the web/BFF surface — links inside emails (PHASE-003)
WEB_BASE_URL=http://localhost:3000

# Worker entrypoint flag (PHASE-002+); 0 = web/api process
WORKER_MODE=0

# Logging level (pino)
LOG_LEVEL=debug

# HTTP port of the API app in development
PORT=3001

# PHASE-024 (R-04) per-tenant API burst ceiling per 10 s window — read
# directly by the rate limiter (not the zod env schema) at construction.
# Unset → 1000 (sized for the test suite's sequential traffic; production
# tuning is an ops decision).
# TENANT_RATE_LIMIT_MAX=1000
